    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@turbomusic/core": "workspace:*",
    "@hono/node-server": "^1.19.18",
    "hono": "^4.13.16"
  },
  "devDependencies": { "@types/node": "^22.5.5", "typescript": "^5.5.3", "vitest": "^4.1.12" }
}
